APP_NAME=FactoryOffice-Agent
APP_ENV=development
API_V1_PREFIX=/api
FRONTEND_BASE_URL=http://localhost:3000
AUTH_SECRET_KEY=dev-only-change-me

DATABASE_URL=postgresql+psycopg://factory_user:factory_pass@localhost:5432/factory_agent

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_MODEL=text-embedding-3-small

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
INTEGRATION_CALLBACK_BASE_URL=http://localhost:8000
ENCRYPTION_KEY=replace-with-32-byte-base64-key

UPLOAD_DIR=data/uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_CHUNK_SIZE_BYTES=1048576
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=factoryoffice
JOB_MAX_RETRIES=3
JOB_RETRY_INTERVALS=60,300,900
JOB_SCHEDULER_INTERVAL_SECONDS=60
JOB_BATCH_SIZE=50
