APP_NAME=FactoryOffice-Agent
APP_ENV=production
API_V1_PREFIX=/api
FRONTEND_BASE_URL=https://factoryoffice.example.com
AUTH_SECRET_KEY=replace-with-long-random-secret

DATABASE_URL=postgresql+psycopg://factory_user:factory_pass@postgres:5432/factory_agent
REDIS_URL=redis://redis:6379/0

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-llm-key
LLM_MODEL=deepseek-chat

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_MODEL=text-embedding-3-small

WECOM_CORP_ID=replace-with-wecom-corp-id
WECOM_AGENT_ID=replace-with-wecom-agent-id
WECOM_SECRET=replace-with-wecom-secret
DINGTALK_APP_KEY=replace-with-dingtalk-app-key
DINGTALK_APP_SECRET=replace-with-dingtalk-app-secret
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=replace-with-feishu-app-secret
INTEGRATION_CALLBACK_BASE_URL=https://factoryoffice.example.com/api/callbacks
ENCRYPTION_KEY=replace-with-32-byte-base64-key

UPLOAD_DIR=/app/data/uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_CHUNK_SIZE_BYTES=1048576
CORS_ORIGINS=["https://factoryoffice.example.com"]

JOB_QUEUE_NAME=factoryoffice
JOB_MAX_RETRIES=3
JOB_RETRY_INTERVALS=60,300,900
JOB_SCHEDULER_INTERVAL_SECONDS=60
JOB_BATCH_SIZE=50
